# Rendered at container start by the image's envsubst step: only defined variables (API_UPSTREAM,
# NGINX_LOCAL_RESOLVERS) are substituted, so nginx's own $variables are left alone.
# Behind Azure Container Apps, TLS ends at the ingress, so keep the scheme it reports.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Re-resolve the API's name every 10 s instead of once at startup, so a restarted API gets a new address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The browser calls same-origin /api; the path is passed through unchanged (no URI part on proxy_pass).
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        # Host stays the upstream's own name ($proxy_host): Azure Container Apps ingress routes by Host.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # With a variable proxy_pass nginx doesn't rewrite redirects, so an upstream Location
        # (e.g. a trailing-slash redirect to http://api:8000/api/...) would send the browser to an internal host.
        proxy_redirect ~^https?://[^/]+(/.*)$ $1;
        # An https upstream (Container Apps internal ingress) is verified against the system CA bundle.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        # Fetch now runs in the request; match the Container Apps ingress limit so local behaves like Azure.
        proxy_read_timeout 240s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The UI container's own liveness; it does not depend on the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Content-hashed build output: cache for a year; a missing file is a 404, never index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Client-side routes (/articles/1, /review) fall back to the app shell, which is never cached.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
