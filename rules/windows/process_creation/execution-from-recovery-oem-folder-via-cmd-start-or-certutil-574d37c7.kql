DeviceProcessEvents
| where ((FolderPath endswith "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.Exe") and (ProcessCommandLine contains "/c" and ProcessCommandLine contains "start" and ProcessCommandLine contains "\\Recovery\\OEM\\")) or ((FolderPath endswith "\\certutil.exe" or ProcessVersionInfoOriginalFileName =~ "CertUtil.exe") and ProcessCommandLine contains "urlcache" and (ProcessCommandLine contains " -f" or ProcessCommandLine contains " –f"))
